{
  "name": "price-tracker-backend",
  "version": "1.0.0",
  "description": "Express API + Playwright scraper for the mock storefront price tracker",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "postinstall": "prisma generate",
    "db:schema": "node src/cli/applySchema.js && prisma db pull && prisma generate",
    "db:generate": "prisma generate",
    "catalog:sync": "node src/cli/syncCatalog.js",
    "scrape:headed": "node src/cli/scrapeHeaded.js"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
