generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model catalog_products {
  store_product_id Int      @id
  slug             String
  name             String
  brand            String?
  category         String?
  sku              String?
  last_seen_at     DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model price_observations {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tracked_product_id String           @db.Uuid
  scrape_attempt_id  String           @unique @db.Uuid
  price              Decimal          @db.Decimal(12, 2)
  mrp                Decimal?         @db.Decimal(12, 2)
  currency           String
  stock_qty          Int
  captured_at        DateTime         @db.Timestamptz(6)
  scrape_attempts    scrape_attempts  @relation(fields: [scrape_attempt_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tracked_products   tracked_products @relation(fields: [tracked_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tracked_product_id, captured_at(sort: Desc)], map: "idx_obs_target_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model scrape_attempts {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id              String              @db.Uuid
  tracked_product_id  String              @db.Uuid
  attempt_number      Int
  started_at          DateTime            @db.Timestamptz(6)
  finished_at         DateTime?           @db.Timestamptz(6)
  duration_ms         Int?
  outcome             String
  method              String              @default("browser")
  http_status         Int?
  error_code          String?
  error_message       String?
  manifest_revision   Int?
  raw_price_text      String?
  raw_stock_text      String?
  extracted_price     Decimal?            @db.Decimal(12, 2)
  extracted_stock_qty Int?
  price_observations  price_observations?
  scrape_runs         scrape_runs         @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tracked_products    tracked_products    @relation(fields: [tracked_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tracked_product_id, run_id, attempt_number])
  @@index([run_id], map: "idx_attempts_run")
  @@index([tracked_product_id, started_at(sort: Desc)], map: "idx_attempts_target_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model scrape_runs {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_key         String            @unique
  trigger_source  String
  status          String            @default("running")
  started_at      DateTime          @default(now()) @db.Timestamptz(6)
  finished_at     DateTime?         @db.Timestamptz(6)
  target_count    Int               @default(0)
  success_count   Int               @default(0)
  failure_count   Int               @default(0)
  scrape_attempts scrape_attempts[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tracked_products {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_product_id     Int
  product_name         String
  product_url          String
  option_axis          String?
  selected_option      String
  selected_option_key  String
  active               Boolean              @default(true)
  current_price        Decimal?             @db.Decimal(12, 2)
  current_mrp          Decimal?             @db.Decimal(12, 2)
  currency             String?
  current_stock_qty    Int?
  last_success_at      DateTime?            @db.Timestamptz(6)
  last_attempt_at      DateTime?            @db.Timestamptz(6)
  last_outcome         String?
  consecutive_failures Int                  @default(0)
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime             @default(now()) @db.Timestamptz(6)
  price_observations   price_observations[]
  scrape_attempts      scrape_attempts[]

  @@unique([store_product_id, selected_option_key], map: "uq_tracked_active_target", where: raw("active"))
  @@index([active], map: "idx_tracked_active")
}
